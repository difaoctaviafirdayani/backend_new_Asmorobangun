{
  "name": "asmorobangun-backend",
  "version": "3.0.0",
  "description": "Backend API Sanggar Asmorobangun (Express + TypeScript + MySQL/TiDB) — terstruktur per kelompok modul",
  "main": "src/index.ts",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "ts-node --transpile-only src/index.ts",
    "dev": "nodemon --watch src --ext js,ts,json --exec ts-node --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "fix:users": "ts-node --transpile-only scripts/fix-duplicate-users.ts",
    "create:admin": "ts-node --transpile-only scripts/create-admin.ts",
    "seed:gallery": "ts-node --transpile-only scripts/seed-gallery.ts"
  },
  "dependencies": {
    "adm-zip": "^0.5.10",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.5",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.12.1",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.24.6",
    "nanoid": "^3.3.7",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
