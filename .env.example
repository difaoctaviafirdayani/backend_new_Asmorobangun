# Salin file ini menjadi .env lalu isi sesuai kebutuhan.
# Semua nilai di bawah ini OPSIONAL — server tetap jalan normal tanpa .env sama sekali.

# Port server backend (default 4000)
PORT=4000

# Ganti dengan string acak yang panjang untuk produksi (dipakai untuk menandatangani token login/JWT)
JWT_SECRET=asmorobangun-dev-secret-change-me

# OPSIONAL: isi dengan API key Anthropic asli (dari console.anthropic.com) supaya
# fitur "Asisten Asmorobangun" (chatbot AI) menjawab pakai Claude sungguhan.
# Kalau dikosongkan, chatbot tetap jalan pakai jawaban rule-based bawaan (lihat src/routes/ai.routes.js).
ANTHROPIC_API_KEY=
