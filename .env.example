# Salin file ini menjadi .env lalu isi sesuai kebutuhan.
# Semua nilai OPSIONAL — server tetap jalan tanpa .env.

# Port server backend (default 4000)
PORT=4000
# 0.0.0.0 = bisa diakses dari HP / emulator Flutter di jaringan yang sama
HOST=0.0.0.0

# Ganti dengan teks acak yang panjang (dipakai untuk menandatangani token login)
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang

# Batasi website mana yang boleh memanggil API (pisah dengan koma).
# Kosong = semua boleh (cukup untuk development).
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Alamat backend yang dilihat dari luar (untuk URL gambar lengkap di Flutter di HP asli)
# PUBLIC_URL=http://192.168.1.10:4000
# true = semua respons selalu memakai URL gambar lengkap (http://...)
# ABSOLUTE_URLS=false

# OPSIONAL: chatbot topeng memakai AI sungguhan (API yang kompatibel dengan OpenAI).
# Kosong = pakai jawaban bawaan (rule-based).
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
